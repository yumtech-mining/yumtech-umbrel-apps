# systemd kurulumu bu değerleri /etc/default/yumtech-ckpool-dashboard dosyasından okur.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8096
CKPOOL_CONFIG=/etc/ckpool/ckpool.conf
CKPOOL_STRATIFIER_SOCKET=/tmp/ckpool/stratifier
CKPOOL_LOG=/var/log/ckpool/ckpool.log
CKPOOL_USERS_DIR=/var/log/ckpool/users
DASHBOARD_RETENTION_DAYS=30
# DASHBOARD_USER=yumtech
# DASHBOARD_PASSWORD=guclu-bir-parola
