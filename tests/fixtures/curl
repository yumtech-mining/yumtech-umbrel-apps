#!/usr/bin/env bash
set -euo pipefail

output=""
url=""
while (($#)); do
    case "$1" in
        --output|-o)
            output="$2"
            shift 2
            ;;
        http://*|https://*)
            url="$1"
            shift
            ;;
        *)
            shift
            ;;
    esac
done

[[ -n "${output}" && -n "${url}" ]]
case "${url}" in
    */linux/docker-compose.yml)
        cp "${YUMTECH_TEST_SOURCE_ROOT}/linux/docker-compose.yml" "${output}"
        ;;
    */install-linux.sh)
        cp "${YUMTECH_TEST_SOURCE_ROOT}/install-linux.sh" "${output}"
        ;;
    *)
        printf 'Unexpected fake curl URL: %s\n' "${url}" >&2
        exit 1
        ;;
esac
