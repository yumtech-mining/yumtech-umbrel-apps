#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "info" ]]; then
    exit 0
fi
if [[ "${1:-}" == "compose" && "${2:-}" == "version" ]]; then
    printf 'Docker Compose version v2.40.0\n'
    exit 0
fi

arguments=" $* "
case "${arguments}" in
    *" exec "*)
        printf '{"online": true}\n'
        ;;
    *" ps "*)
        printf 'yumtech-dashboard-1 running\n'
        ;;
    *" config "*|*" pull "*|*" up "*|*|*" down "*|*" logs "*)
        ;;
    *)
        printf 'Unexpected fake Docker command: %s\n' "$*" >&2
        exit 1
        ;;
esac
